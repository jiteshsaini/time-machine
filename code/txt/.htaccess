# Deny direct web access to the app's state files (paths.txt, starred_paths.txt,
# action_password.txt, playlists.json, audit.log, etc.). These are read/written
# only by the PHP backend; never served raw over HTTP.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
