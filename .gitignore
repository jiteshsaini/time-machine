# macOS junk
.DS_Store
._*

# Ignore Claude files
.claude

# Only the sample albums belong in the repo — never anyone's own photos,
# whatever their folders are called
images/*
!images/Sample_Albums/

# Ignore runtime state
trash/
code/txt/*.log
code/txt/*.json
code/txt/current_playlist.txt
**/.resize_progress.json

# Syncthing (keeps a copy of the library on a phone)
.stfolder
.stignore
.stversions

# Optional
*.log
*.tmp
